const {parseExamStructureV6}=require('./lib/exam-import');

app.post('/api/teacher/imports/:id/analyze-v6',auth,role('teacher'),async(req,res,next)=>{try{
  const item=(await q(`SELECT * FROM import_jobs WHERE id=$1 AND owner_id=$2`,[req.params.id,req.user.id])).rows[0];if(!item)return res.status(404).json({message:'Không tìm thấy tác vụ nhập'});
  const detected=ExamTools.metadata(item.extracted_text,item.original_name);
  if((Number(item.analysis_version)>=6||item.kind==='json')&&!req.body.force)return res.json({item:{...item,analysis_meta:{...detected,...item.analysis_meta}},questions:item.draft_questions||[],sections:item.sections||[],meta:{...detected,...item.analysis_meta}});
  if(!String(item.extracted_text||'').trim())return res.status(400).json({message:'Tệp không có lớp văn bản để phân tích. PDF scan cần OCR trước khi phân loại tự động.'});
  const out=parseExamStructureV6(item.extracted_text);
  out.meta={...detected,...out.meta,title:out.meta.title||detected.title};
  // Keep imported illustrations already attached to the same numbered question.
  for(const question of out.questions){const old=(item.draft_questions||[]).find(x=>x.questionNo===question.questionNo&&x.sectionId===question.sectionId);if(old?.images)question.images=old.images;if(['underline','conflict'].includes(old?.answerSource)){question.answer=old.answer;question.answerSource=old.answerSource;}}
  const warnings=Array.isArray(item.warnings)?[...item.warnings]:[];
  if(out.questions.some(x=>x.confidence==='low'))warnings.push('Một số câu có độ tin cậy nhận diện thấp; hãy kiểm tra loại câu trước khi tạo đề.');
  const updated=(await q(`UPDATE import_jobs SET draft_questions=$1,sections=$2,analysis_version=6,analysis_meta=$3,warnings=$4,updated_at=now() WHERE id=$5 RETURNING *`,[JSON.stringify(out.questions),JSON.stringify(out.sections),JSON.stringify(out.meta),JSON.stringify([...new Set(warnings)]),item.id])).rows[0];
  await audit(req.user.id,'import.analyzed_v6',{importId:item.id,...out.meta});res.json({item:updated,questions:out.questions,sections:out.sections,meta:out.meta});
}catch(e){next(e)}});

app.post('/api/teacher/imports/:id/review-v6',auth,role('teacher'),async(req,res,next)=>{try{
  const item=(await q(`SELECT id FROM import_jobs WHERE id=$1 AND owner_id=$2`,[req.params.id,req.user.id])).rows[0];if(!item)return res.status(404).json({message:'Không tìm thấy tác vụ nhập'});
  let questions,sections;try{questions=validQuestionsForSave(req.body.questions,false);for(const question of questions)question.images=await normalizeBankImagesV5(question.images,req.user.id);sections=ExamTools.sections(questions,req.body.sections||[]);}catch(e){return res.status(400).json({message:e.message});}
  await q(`UPDATE import_jobs SET draft_questions=$1,sections=$2,analysis_meta=analysis_meta || $4::jsonb,updated_at=now() WHERE id=$3`,[JSON.stringify(questions),JSON.stringify(sections),item.id,JSON.stringify(req.body.metadata?{title:String(req.body.metadata.title||'').slice(0,240),subject:String(req.body.metadata.subject||'').slice(0,100),duration:Number(req.body.metadata.duration)||45}:{})]);await audit(req.user.id,'import.review_saved_v6',{importId:item.id,questions:questions.length,sections:sections.length});res.json({ok:true});
}catch(e){next(e)}});

app.post('/api/teacher/imports/:id/create-exam-v6',auth,role('teacher'),async(req,res,next)=>{try{
  const item=(await q(`SELECT * FROM import_jobs WHERE id=$1 AND owner_id=$2`,[req.params.id,req.user.id])).rows[0];if(!item)return res.status(404).json({message:'Không tìm thấy tác vụ nhập'});
  const questions=(Array.isArray(req.body.questions)?req.body.questions:item.draft_questions||[]).slice(0,300);if(!questions.length)return res.status(400).json({message:'Chưa có câu hỏi để tạo đề'});
  let sections;try{validQuestionsForSave(questions,false);for(const question of questions)question.images=await normalizeBankImagesV5(question.images,req.user.id);sections=ExamTools.sections(questions,req.body.sections||item.sections||[]);ExamTools.settings({duration:Number(req.body.duration||45)});}catch(e){return res.status(400).json({message:e.message});}const max=+questions.reduce((s,x)=>s+Number(x.points||0),0).toFixed(4);
  const metadata={...ExamTools.metadata(item.extracted_text,item.original_name),...item.analysis_meta};
  const exam=(await q(`INSERT INTO exams(title,subject,duration,max_score,questions,sections,owner_id,status,updated_at,exam_config) VALUES($1,$2,$3,$4,$5,$6,$7,'draft',now(),$8) RETURNING *`,[String(req.body.title||metadata.title||item.original_name.replace(/\.[^.]+$/,'')).trim(),String(req.body.subject||metadata.subject||''),Math.max(1,Number(req.body.duration||metadata.duration||45)),max||10,JSON.stringify(questions),JSON.stringify(sections),req.user.id,JSON.stringify({instructions:metadata.instructions||''})])).rows[0];
  await q(`UPDATE import_jobs SET draft_questions=$1,sections=$2,analysis_meta=analysis_meta || $4::jsonb,updated_at=now() WHERE id=$3`,[JSON.stringify(questions),JSON.stringify(sections),item.id,JSON.stringify(req.body.metadata?{title:String(req.body.metadata.title||'').slice(0,240),subject:String(req.body.metadata.subject||'').slice(0,100),duration:Number(req.body.metadata.duration)||45}:{})]);await audit(req.user.id,'import.exam_created_v6',{importId:item.id,examId:exam.id,maxScore:max,sections:sections.length});res.json({exam});
}catch(e){next(e)}});

function normalizeProctorV6(raw={}){
  const mode=['off','monitor','strict'].includes(raw.mode)?raw.mode:'off';
  if(mode==='off')return {mode:'off',monitorTab:false,requireFullscreen:false,blockCopy:false,blockPaste:false,blockContextMenu:false,warnStudent:false};
  if(mode==='monitor')return {mode,monitorTab:true,requireFullscreen:!!raw.requireFullscreen,blockCopy:!!raw.blockCopy,blockPaste:!!raw.blockPaste,blockContextMenu:!!raw.blockContextMenu,warnStudent:true};
  return {mode:'strict',monitorTab:true,requireFullscreen:true,blockCopy:raw.blockCopy!==false,blockPaste:raw.blockPaste!==false,blockContextMenu:raw.blockContextMenu!==false,warnStudent:true};
}
app.post('/api/teacher/assignments/:id/proctor',auth,role('teacher'),async(req,res,next)=>{try{
  const own=(await q(`SELECT a.id FROM assignments a JOIN classes c ON c.id=a.class_id WHERE a.id=$1 AND c.teacher_id=$2`,[req.params.id,req.user.id])).rows[0];if(!own)return res.status(404).json({message:'Không tìm thấy ca thi'});
  const cfg=normalizeProctorV6(req.body||{});const row=(await q(`UPDATE assignments SET proctor_config=$1 WHERE id=$2 RETURNING *`,[JSON.stringify(cfg),own.id])).rows[0];await audit(req.user.id,'assignment.proctor_updated',{assignmentId:own.id,mode:cfg.mode});res.json({assignment:row,config:cfg});
}catch(e){next(e)}});
app.get('/api/student/attempt/:id/proctor',auth,role('student'),async(req,res,next)=>{try{
  const row=(await q(`SELECT at.id,at.status,a.proctor_config FROM attempts at JOIN assignments a ON a.id=at.assignment_id WHERE at.id=$1 AND at.student_id=$2`,[req.params.id,req.user.id])).rows[0];if(!row)return res.status(404).json({message:'Không tìm thấy lượt thi'});res.json({config:normalizeProctorV6(row.proctor_config||{}),status:row.status});
}catch(e){next(e)}});
const proctorEventTypesV6=new Set(['visibility_hidden','visibility_visible','window_blur','window_focus','fullscreen_exit','fullscreen_enter','copy','paste','contextmenu']);
app.post('/api/student/attempt/:id/proctor-events',auth,role('student'),async(req,res,next)=>{try{
  const row=(await q(`SELECT at.id,at.status,a.proctor_config FROM attempts at JOIN assignments a ON a.id=at.assignment_id WHERE at.id=$1 AND at.student_id=$2`,[req.params.id,req.user.id])).rows[0];if(!row)return res.status(404).json({message:'Không tìm thấy lượt thi'});const cfg=normalizeProctorV6(row.proctor_config||{});if(cfg.mode==='off')return res.json({ok:true,ignored:true});
  const type=String(req.body.type||'');if(!proctorEventTypesV6.has(type))return res.status(400).json({message:'Sự kiện giám sát không hợp lệ'});
  const recent=(await q(`SELECT 1 FROM attempt_events WHERE attempt_id=$1 AND event_type=$2 AND created_at>now()-interval '1 second' LIMIT 1`,[row.id,type])).rowCount;if(recent)return res.json({ok:true,dedup:true});
  const warn=new Set(['visibility_hidden','window_blur','fullscreen_exit','copy','paste','contextmenu']);const severity=warn.has(type)?'warning':'info';const meta={mode:cfg.mode,fullscreen:!!req.body.fullscreen,hidden:!!req.body.hidden,viewport:String(req.body.viewport||'').slice(0,60)};
  const ev=(await q(`INSERT INTO attempt_events(attempt_id,event_type,severity,meta) VALUES($1,$2,$3,$4) RETURNING id,created_at`,[row.id,type,severity,JSON.stringify(meta)])).rows[0];res.json({ok:true,event:ev});
}catch(e){next(e)}});

async function monitorPayloadV6(assignmentId,teacherId){
  const own=(await q(`SELECT a.id,a.class_id,a.proctor_config,c.name class_name,e.title exam_title,jsonb_array_length(e.questions)::int total_questions FROM assignments a JOIN classes c ON c.id=a.class_id JOIN exams e ON e.id=a.exam_id WHERE a.id=$1 AND c.teacher_id=$2`,[assignmentId,teacherId])).rows[0];if(!own)return null;
  await finalizeExpiredAttempts();
  const attempts=(await q(`SELECT u.id student_id,u.name,u.login,at.id attempt_id,COALESCE(at.status,'not_started') status,at.started_at,at.deadline_at,at.last_saved_at,at.score,CASE WHEN at.id IS NULL THEN 0 ELSE (SELECT count(*)::int FROM jsonb_object_keys(COALESCE(at.answers,'{}'::jsonb))) END answered,CASE WHEN at.id IS NULL THEN 0 ELSE (SELECT count(*)::int FROM attempt_events ev WHERE ev.attempt_id=at.id AND ev.severity='warning') END violations,(SELECT ev.event_type FROM attempt_events ev WHERE ev.attempt_id=at.id ORDER BY ev.created_at DESC LIMIT 1) last_event,(SELECT ev.created_at FROM attempt_events ev WHERE ev.attempt_id=at.id ORDER BY ev.created_at DESC LIMIT 1) last_event_at FROM enrollments en JOIN users u ON u.id=en.student_id LEFT JOIN attempts at ON at.assignment_id=$1 AND at.student_id=u.id WHERE en.class_id=$2 ORDER BY u.name`,[own.id,own.class_id])).rows;
  const events=(await q(`SELECT ev.id,ev.event_type,ev.severity,ev.created_at,u.name,u.login FROM attempt_events ev JOIN attempts at ON at.id=ev.attempt_id JOIN users u ON u.id=at.student_id WHERE at.assignment_id=$1 ORDER BY ev.created_at DESC LIMIT 60`,[own.id])).rows;
  return {assignment:{...own,proctor_config:normalizeProctorV6(own.proctor_config||{})},attempts,events,serverTime:new Date().toISOString()};
}
app.get('/api/teacher/monitor/:id/stream-v6',auth,role('teacher'),async(req,res,next)=>{try{
  const first=await monitorPayloadV6(req.params.id,req.user.id);if(!first)return res.status(403).end();res.setHeader('Content-Type','text/event-stream');res.setHeader('Cache-Control','no-cache, no-transform');res.setHeader('Connection','keep-alive');res.flushHeaders?.();let closed=false;
  let sending=false;const send=async()=>{if(closed||sending)return;sending=true;try{const d=await monitorPayloadV6(req.params.id,req.user.id);if(d&&!closed)res.write(`data: ${JSON.stringify(d)}\n\n`)}catch{}finally{sending=false}};const timer=setInterval(send,3000);req.on('close',()=>{closed=true;clearInterval(timer)});await send();
}catch(e){next(e)}});
app.get('/api/teacher/assignments/:id/proctor-report',auth,role('teacher'),async(req,res,next)=>{try{const d=await monitorPayloadV6(req.params.id,req.user.id);if(!d)return res.status(404).json({message:'Không tìm thấy ca thi'});res.json(d)}catch(e){next(e)}});
