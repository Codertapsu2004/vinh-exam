const multerV4 = require('multer');
const uploadQuestionAssetV4 = multerV4({storage:multerV4.memoryStorage(),limits:{fileSize:6*1024*1024,files:1}});
const allowedQuestionImageTypesV4 = new Set(['image/png','image/jpeg','image/webp','image/gif']);

app.post('/api/teacher/question-assets', auth, role('teacher'), uploadQuestionAssetV4.single('file'), async(req,res,next)=>{try{
  if(!req.file)return res.status(400).json({message:'Hãy chọn ảnh để tải lên'});
  if(!allowedQuestionImageTypesV4.has(req.file.mimetype))return res.status(400).json({message:'Chỉ hỗ trợ PNG, JPG, WEBP hoặc GIF'});
  const row=(await q(`INSERT INTO assets(owner_id,original_name,mime_type,size_bytes,data) VALUES($1,$2,$3,$4,$5) RETURNING id,original_name,mime_type,size_bytes,created_at`,[req.user.id,req.file.originalname,req.file.mimetype,req.file.size,req.file.buffer])).rows[0];
  await audit(req.user.id,'question.asset_uploaded',{assetId:row.id,name:row.original_name,size:row.size_bytes});
  res.json({asset:{...row,url:'/api/question-assets/'+row.id}});
}catch(e){next(e)}});

app.get('/api/question-assets/:id', auth, async(req,res,next)=>{try{
  const asset=(await q(`SELECT id,owner_id,original_name,mime_type,size_bytes,data FROM assets WHERE id=$1`,[req.params.id])).rows[0];
  if(!asset)return res.status(404).end();
  if(!allowedQuestionImageTypesV4.has(asset.mime_type))return res.status(415).end();
  let allowed=req.user.role==='admin'||asset.owner_id===req.user.id;
  if(!allowed&&req.user.role==='student'){
    const found=(await q(`SELECT 1 FROM attempts at JOIN assignments a ON a.id=at.assignment_id JOIN exams e ON e.id=a.exam_id WHERE at.student_id=$1 AND EXISTS (SELECT 1 FROM jsonb_array_elements(COALESCE(e.questions,'[]'::jsonb)) qj WHERE EXISTS (SELECT 1 FROM jsonb_array_elements(COALESCE(qj->'images','[]'::jsonb)) ij WHERE ij->>'assetId'=$2)) LIMIT 1`,[req.user.id,asset.id])).rowCount>0;
    allowed=found;
  }
  if(!allowed)return res.status(403).end();
  res.setHeader('Content-Type',asset.mime_type);
  res.setHeader('Content-Length',asset.size_bytes);
  res.setHeader('Cache-Control','private, max-age=3600');
  res.setHeader('X-Content-Type-Options','nosniff');
  res.setHeader('Content-Disposition',`inline; filename*=UTF-8''${encodeURIComponent(asset.original_name)}`);
  res.send(asset.data);
}catch(e){next(e)}});
